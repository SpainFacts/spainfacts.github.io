# Copia este archivo como .env (el .env real está en .gitignore y NUNCA se versiona).
# Genera el token en https://app.motherduck.com/ -> Settings -> Access Tokens.

# Token que usa Evidence (npm run sources / build) en local.
# En GitHub Actions este mismo valor va en el secret EVIDENCE_SOURCE__MOTHER__TOKEN.
EVIDENCE_SOURCE__mother__token=

# Token que usan los scripts de carga de datos (scripts/*.py).
# Los scripts leen la variable de entorno directamente; en PowerShell:
#   $env:motherduck_token = "..."
# o exporta el contenido de este .env antes de ejecutarlos.
motherduck_token=
