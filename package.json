{
  "name": "my-evidence-project",
  "version": "0.0.1",
  "scripts": {
    "build": "evidence build",
    "build:strict": "evidence build:strict",
    "dev": "evidence dev --open /",
    "test": "npm run test:i18n && npm run test:web",
    "sources": "evidence sources",
    "sources:strict": "evidence sources --strict",
    "preview": "evidence preview",
    "postinstall": "patch-package",
    "build:parcial": "node tools/build-parcial.mjs",
    "test:i18n": "node tools/i18n/comprobar.mjs && node tools/i18n/estado.mjs",
    "test:estatico": "node tools/pruebas/estatico.mjs",
    "test:humo": "node tools/pruebas/humo.mjs",
    "test:web": "node tools/pruebas/estatico.mjs && node tools/pruebas/humo.mjs",
    "test:publicada": "node tools/pruebas/humo.mjs --base https://spainfacts.org"
  },
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=18.0.0"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@evidence-dev/bigquery": "^2.0.10",
    "@evidence-dev/component-utilities": "file:./vendor/evidence-dev-component-utilities-4.0.13.tgz",
    "@evidence-dev/core-components": "^5.2.2",
    "@evidence-dev/csv": "^1.0.14",
    "@evidence-dev/databricks": "^1.0.8",
    "@evidence-dev/duckdb": "^2.0.0",
    "@evidence-dev/evidence": "^40.1.2",
    "@evidence-dev/motherduck": "^1.0.5",
    "@evidence-dev/mssql": "^1.1.2",
    "@evidence-dev/mysql": "^1.1.4",
    "@evidence-dev/postgres": "^1.0.7",
    "@evidence-dev/snowflake": "^1.2.2",
    "@evidence-dev/source-javascript": "^0.0.3",
    "@evidence-dev/sqlite": "^2.0.7",
    "@evidence-dev/trino": "^1.0.9",
    "@huggingface/transformers": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "overrides": {
    "@evidence-dev/component-utilities": "$@evidence-dev/component-utilities",
    "jsonwebtoken": "9.0.0",
    "trim@<0.0.3": ">0.0.3",
    "sqlite3": "5.1.5",
    "axios": "^1.7.4"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "playwright": "^1.63.0"
  }
}
