+/** SpainFacts: vistas registradas pero aún no creadas, por nombre de tabla en minúsculas */
+const vistasPendientes = new Map();
+
+/** Crea (una sola vez, aunque haya consultas simultáneas) las vistas que usa esta consulta */
+async function crearVistasNecesarias(sql) {
+	if (!vistasPendientes.size) return;
+	const palabras = new Set(String(sql).toLowerCase().match(/[a-z_][a-z0-9_]*/g) ?? []);
+	const tareas = [];
+	for (const [tabla, vista] of vistasPendientes) {
+		if (!palabras.has(tabla)) continue;
+		vista.promesa ??= connection.query(vista.sql).catch((e) => {
+			vista.promesa = undefined; // se reintentará en la siguiente consulta
+			throw e;
+		});
+		tareas.push(vista.promesa);
+	}
+	await Promise.all(tareas);
+}
