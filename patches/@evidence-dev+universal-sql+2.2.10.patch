+/*
+	SpainFacts (patch-package): caché de resultados que sobrevive entre builds. En un deploy de solo
+	código los parquets no cambian, así que casi todas las consultas del prerender dan lo mismo que
+	en el anterior. Solo actúa con SPAINFACTS_CACHE_CONSULTAS (carpeta; en el deploy va en la caché
+	de Actions). La clave es el cuerpo normalizado del SQL + el md5 de cada parquet cuyo nombre de
+	tabla aparece como palabra en la consulta + la versión de DuckDB: si cambian los datos de una
+	tabla, sus consultas se recalculan. Las que dependen de la hora o del azar no se guardan. Cada
+	acierto renueva la fecha del fichero, así el deploy borra después los que este build no ha usado.
+*/
+const DIR_PERSISTENTE = process.env.SPAINFACTS_CACHE_CONSULTAS;
+// package.json por ruta: el campo exports de duckdb-wasm no deja pedirlo con require
+const VERSION_PERSISTENTE = `v1|duckdb-wasm ${
