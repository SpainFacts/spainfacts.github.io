+/** @type {Map<string, string[]> | null} nombre de tabla en minúsculas -> md5 de sus parquets */
+let huellas = null;
+function huella_tablas() {
+	if (huellas) return huellas;
+	huellas = new Map();
+	const base = 'static/data';
+	if (!existsSync(base)) return huellas;
+	for (const fuente of readdirSync(base, { withFileTypes: true })) {
+		if (!fuente.isDirectory()) continue;
+		for (const tabla of readdirSync(`${base}/${fuente.name}`, { withFileTypes: true })) {
+			if (!tabla.isDirectory()) continue;
+			const fichero = `${base}/${fuente.name}/${tabla.name}/${tabla.name}.parquet`;
+			if (!existsSync(fichero)) continue;
+			const nombre = tabla.name.toLowerCase();
+			huellas.set(nombre, [...(huellas.get(nombre) ?? []), `${fuente.name}.${nombre}=${hash(readFileSync(fichero))}`]);
+		}
+	}
