+function cuerpo(sql) {
+	const alias = new Map();
+	return String(sql)
+		.replace(/^---- [^\n]*\n/, '')
+		.replace(/"inputQuery-[A-Za-z0-9_-]+"/g, (a) => {
+			if (!alias.has(a)) alias.set(a, `"inputQuery-${alias.size}"`);
+			return alias.get(a);
+		});
