+	if (!tablas.size) return null;
+	const usadas = [...new Set(clave.toLowerCase().match(/[a-z_][a-z0-9_]*/g) ?? [])]
+		.filter((p) => tablas.has(p))
+		.sort()
+		.flatMap((p) => tablas.get(p));
+	return `${DIR_PERSISTENTE}/${hash(`${VERSION_PERSISTENTE}\n${usadas.join('\n')}\n${clave}`)}.arrow`;
+}
+
+function leer_persistente(clave) {
+	const ruta = ruta_persistente(clave);
+	if (!ruta || !existsSync(ruta)) return null;
+	const ahora = new Date();
+	utimesSync(ruta, ahora, ahora);
+	return tableFromIPC(readFileSync(ruta));
+}
