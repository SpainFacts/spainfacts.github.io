+		"Estado de derecho (WJP)": "Rule of law (WJP)",
+		"Eficacia del gobierno": "Government effectiveness",
+		"Corrupción política": "Political corruption",
+		"Control de la corrupción": "Control of corruption",
+		"Voz y rendición de cuentas": "Voice and accountability",
+		"Corrupción en el sector público": "Public sector corruption",
+		"Percepción de la corrupción": "Corruption perceptions",
