+		// Valores x de los datos
+		let xs = [];
+		if (ejeX.type === 'category' && Array.isArray(ejeX.data) && ejeX.data.length) {
+			xs = ejeX.data.map((c) => (c && typeof c === 'object' ? c.value : c));
+		} else {
+			for (const s of config.series) {
+				if (!Array.isArray(s?.data)) continue;
+				for (const d of s.data) {
+					const x = xDe(d);
+					if (x !== undefined) xs.push(x);
+				}
+			}
+		}
+		if (xs.length < 3) return config;
+
+		// Modo: fechas o años
+		let modo = null;
+		let tiempos = xs.map(aFecha).filter((t) => t != null);
+		if (tiempos.length >= xs.length * 0.8) modo = 'fecha';
+		let anios = [];
+		if (!modo) {
+			anios = xs.map(esAnio).filter((a) => a != null);
+			if (anios.length >= xs.length * 0.8) modo = 'anio';
+		}
+		if (!modo) return config;
+
+		let lineas = [];
+		if (modo === 'fecha') {
+			const min = Math.min(...tiempos);
+			const max = Math.max(...tiempos);
+			if (max - min < 180 * DIA) return config; // rangos cortos (horas, días): sin eventos
+			for (const e of EVENTOS) {
+				if (!eventoAplica(e, ruta, texto)) continue;
+				const t = Date.parse(e.fecha);
+				if (t <= min || t > max) continue;
+				// eje de categorías con fechas: la categoría más cercana anterior al evento
+				let valor = t;
+				if (ejeX.type === 'category') {
+					const anteriores = xs.filter((x) => aFecha(x) <= t);
+					if (!anteriores.length) continue;
+					valor = anteriores[anteriores.length - 1];
+				}
+				lineas.push({ e, valor });
+			}
+		} else {
+			const min = Math.min(...anios);
+			const max = Math.max(...anios);
+			if (max - min < 3) return config;
+			for (const e of EVENTOS) {
+				if (!eventoAplica(e, ruta, texto)) continue;
+				const anio = Number(e.fecha.slice(0, 4));
+				if (anio <= min || anio > max) continue;
+				let valor = anio;
+				if (ejeX.type === 'category') {
+					valor = xs.find((x) => esAnio(x) === anio);
+					if (valor === undefined) continue;
+				} else {
+					// año con fracción: el evento cae en su punto del año
+					const inicio = Date.parse(`${anio}-01-01`);
+					valor = anio + (Date.parse(e.fecha) - inicio) / (365.25 * DIA);
+				}
+				lineas.push({ e, valor });
+			}
+		}
+		if (!lineas.length) return config;
+
+		// Si hay muchos cambios de gobierno en una serie larga, se dejan solo los de crisis
+		// cuando las líneas quedarían demasiado juntas (más de 8)
+		if (lineas.length > 8) lineas = lineas.filter((l) => l.e.tipo !== 'gobierno');
+
+		const marca = {
+			symbol: ['none', 'none'],
+			silent: true,
+			animation: false,
+			label: {
+				show: true,
+				position: 'insideEndTop',
+				formatter: '{b}',
+				fontSize: 9,
+				color: '#8a8f98'
+			},
+			data: lineas.map(({ e, valor }) => ({
+				xAxis: valor,
+				name: ETIQUETAS_EVENTOS[lang]?.[e.id] ?? e.etiqueta,
+				lineStyle: {
+					type: e.tipo === 'crisis' ? 'dashed' : 'dotted',
+					width: 1,
+					color: e.tipo === 'gobierno' ? e.color : '#8a8f98',
+					opacity: e.tipo === 'gobierno' ? 0.55 : 0.8
+				},
+				label: e.tipo === 'gobierno' ? { color: e.color } : undefined
+			}))
+		};
+
+		// Se engancha a la primera serie para no crear una serie nueva (saldría en la leyenda)
+		const series = config.series.map((s, i) => {
+			if (i !== 0) return s;
+			const previa = s.markLine;
+			return {
+				...s,
+				markLine: previa
+					? { ...previa, data: [...(previa.data ?? []), ...marca.data] }
+					: marca
+			};
+		});
+		return { ...config, series };
+	} catch {
+		return config;
+	}
+}
