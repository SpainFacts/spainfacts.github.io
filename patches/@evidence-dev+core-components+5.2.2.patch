+
+/** ¿Aplica el evento a esta gráfica? (ruta sin prefijo de idioma y texto de la gráfica) */
+export function eventoAplica(e, ruta = '/', texto = '') {
+	if (e.paginas && !e.paginas.some((p) => ruta === p || ruta.startsWith(p + '/'))) return false;
+	if (e.claves && !e.claves.test(texto)) return false;
+	return true;
+}
+
+/** Texto de una configuración de ECharts para buscar las claves: título, series y ejes */
+export function textoDeGrafica(config, extra = '') {
+	if (!config) return extra;
+	const lista = (x) => (Array.isArray(x) ? x : x ? [x] : []);
+	return [
+		extra,
+		...lista(config.title).map((t) => `${t?.text ?? ''} ${t?.subtext ?? ''}`),
+		...lista(config.series).map((s) => s?.name ?? ''),
+		...lista(config.yAxis).map((a) => a?.name ?? ''),
+		...lista(config.xAxis).map((a) => a?.name ?? '')
+	].join(' | ');
+}
+
+const DIA = 86400000;
+
+const aFecha = (v) => {
+	if (v == null) return null;
+	if (v instanceof Date) return v.getTime();
+	if (typeof v === 'number') return v > 1e11 ? v : null; // milisegundos
+	if (typeof v === 'string' && /^\d{4}-\d{2}(-\d{2})?/.test(v)) {
+		const t = Date.parse(v.length === 7 ? v + '-01' : v.slice(0, 10));
+		return Number.isNaN(t) ? null : t;
+	}
+	return null;
+};
+const esAnio = (v) => {
+	const n = typeof v === 'string' && /^\d{4}$/.test(v.trim()) ? Number(v) : v;
+	return typeof n === 'number' && Number.isInteger(n) && n >= 1900 && n <= 2100 ? n : null;
+};
+
+// Valor x de un punto de una serie de ECharts ([x, y], {value: [x, y]} o número suelto)
+const xDe = (d) => {
+	if (Array.isArray(d)) return d[0];
+	if (d && typeof d === 'object' && Array.isArray(d.value)) return d.value[0];
+	return undefined;
+};
+
+const primero = (eje) => (Array.isArray(eje) ? eje[0] : eje);
+
+export function anadirEventos(config, lang = 'es', ruta = '/', texto = '') {
+	try {
+		if (!config || !Array.isArray(config.series) || !config.series.length) return config;
+		if (config.eventos === false) return config;
+		const ejeX = primero(config.xAxis);
+		const ejeY = primero(config.yAxis);
