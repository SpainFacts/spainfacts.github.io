@@ -0,0 +1,72 @@
+// SpainFacts: traducción de las etiquetas que vienen de los DATOS (nombres de series,
+// leyendas y categorías de los ejes) en las páginas traducidas (/en, /ca, /gl, /eu).
+// Las consultas devuelven textos en castellano; aquí se sustituyen al pintar la gráfica.
+// Añadido con patch-package. El diccionario está en etiquetas_diccionario.js.
+import { DICCIONARIO } from './etiquetas_diccionario.js';
+
+const traducir = (texto, dic) => {
+	if (typeof texto !== 'string') return texto;
+	const limpio = texto.trim();
+	if (dic[limpio] !== undefined) return dic[limpio];
+	// "X · España" o "X (INE)": se traduce cada parte si la conoce
+	if (limpio.includes(' · ')) {
+		const partes = limpio.split(' · ');
+		if (partes.some((p) => dic[p] !== undefined)) return partes.map((p) => dic[p] ?? p).join(' · ');
+	}
+	return texto;
+};
+
+const esCategoria = (eje) => eje && (eje.type === 'category' || Array.isArray(eje.data));
+
+export function traducirEtiquetas(config, lang = 'es') {
+	try {
+		if (!config || lang === 'es') return config;
+		const dic = DICCIONARIO[lang];
+		if (!dic || !Array.isArray(config.series)) return config;
+
+		const ejes = (e) => (Array.isArray(e) ? e : e ? [e] : []);
+		const catX = ejes(config.xAxis).some(esCategoria);
+		const catY = ejes(config.yAxis).some(esCategoria);
+
+		const traducirEje = (e) =>
+			Array.isArray(e.data)
+				? { ...e, data: e.data.map((d) => (d && typeof d === 'object' ? { ...d, value: traducir(d.value, dic) } : traducir(d, dic))) }
+				: e;
+
+		const series = config.series.map((s) => {
+			const nueva = { ...s, name: traducir(s.name, dic) };
+			// Sankey y grafos: los enlaces apuntan a los nodos por nombre, se traducen igual
+			if (Array.isArray(s.links))
+				nueva.links = s.links.map((l) => ({ ...l, source: traducir(l.source, dic), target: traducir(l.target, dic) }));
+			if (Array.isArray(s.edges))
+				nueva.edges = s.edges.map((l) => ({ ...l, source: traducir(l.source, dic), target: traducir(l.target, dic) }));
+			if (Array.isArray(s.nodes))
+				nueva.nodes = s.nodes.map((n) => (n && typeof n.name === 'string' ? { ...n, name: traducir(n.name, dic) } : n));
+			if (Array.isArray(s.data)) {
+				nueva.data = s.data.map((d) => {
+					if (Array.isArray(d)) {
+						const c = [...d];
+						if (catX) c[0] = traducir(c[0], dic);
+						if (catY) c[1] = traducir(c[1], dic);
+						return c;
+					}
+					// tartas y embudos: { name, value }
+					if (d && typeof d === 'object' && typeof d.name === 'string') return { ...d, name: traducir(d.name, dic) };
+					return d;
+				});
+			}
+			return nueva;
+		});
+
+		const salida = { ...config, series };
+		if (catX) salida.xAxis = Array.isArray(config.xAxis) ? config.xAxis.map(traducirEje) : traducirEje(config.xAxis);
+		if (catY) salida.yAxis = Array.isArray(config.yAxis) ? config.yAxis.map(traducirEje) : traducirEje(config.yAxis);
+		if (config.legend) {
+			const leyendas = ejes(config.legend).map((l) => (Array.isArray(l.data) ? { ...l, data: l.data.map((d) => traducir(typeof d === 'object' ? d.name : d, dic)) } : l));
+			salida.legend = Array.isArray(config.legend) ? leyendas : leyendas[0];
+		}
+		return salida;
+	} catch {
+		return config;
+	}
+}
